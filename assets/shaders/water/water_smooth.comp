#version 460 core

// water smoothing pass
// pond generation writes a hard field first, this blur softens the surface before mesh extraction

layout(local_size_x = 16, local_size_y = 16) in;

layout(rgba32f, binding = 0) uniform readonly image2D uInputField;
layout(rgba32f, binding = 1) uniform writeonly image2D uOutputField;

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(uInputField);
    if (pixel.x >= size.x || pixel.y >= size.y) return;

    vec4 center = imageLoad(uInputField, pixel);
    float total_water = center.g * 4.0;
    float total_weight = 4.0;

    for (int oy = -1; oy <= 1; ++oy)
    {
        for (int ox = -1; ox <= 1; ++ox)
        {
            if (ox == 0 && oy == 0) continue;

            ivec2 neighbor = pixel + ivec2(ox, oy);
            if (neighbor.x < 0 || neighbor.y < 0 || neighbor.x >= size.x || neighbor.y >= size.y) continue;

            float weight = (ox == 0 || oy == 0) ? 2.0 : 1.0;
            total_water += imageLoad(uInputField, neighbor).g * weight;
            total_weight += weight;
        }
    }

    float water = total_water / max(total_weight, 1e-4);
    if (water > 0.0)
    {
        water = min(water, max(-center.r, 0.0));
    }
    else
    {
        water = min(water, -0.02);
    }

    imageStore(uOutputField, pixel, vec4(center.r, water, center.b, center.a));
}
