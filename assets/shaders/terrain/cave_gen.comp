#version 460 core

layout(local_size_x = 16, local_size_y = 16) in;

layout(rgba32f, binding = 0) uniform coherent image2D ioField;

uniform vec2 uWorldCenter;
uniform vec2 uFieldOrigin;
uniform vec2 uCellSize;
uniform uint uSeed;
uniform float uPlanetRadius;

const float tau = 6.28318530718;

const int cave_slot_count = 16;
const float cave_activation_threshold = 0.14;
const float min_cave_depth = 0.22;
const float max_cave_depth = 0.43;
const float min_cave_radius_tangent = 5.8;
const float max_cave_radius_tangent = 10.8;
const float min_cave_radius_up = 4.2;
const float max_cave_radius_up = 7.0;

#include "terrain/noise.glsl"

float smooth_profile(float value)
{
    float t = clamp(value, 0.0, 1.0);
    return t * t * (3.0 - 2.0 * t);
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(ioField);
    if (pixel.x >= size.x || pixel.y >= size.y) return;

    vec4 field = imageLoad(ioField, pixel);
    float density = field.r;
    float water = field.g;

    vec2 world = uFieldOrigin + vec2(pixel) * uCellSize;

    // Each radial slot grows one cave spine with a few lobes.
    for (int slot = 0; slot < cave_slot_count; ++slot)
    {
        float slot_id = float(slot);
        float activation = hash(vec2(slot_id + 11.3, 7.9));
        if (activation < cave_activation_threshold) continue;

        float angle = tau * ((slot_id + 0.5) / float(cave_slot_count));
        angle += (hash(vec2(slot_id + 3.7, 19.1)) - 0.5) * (tau / float(cave_slot_count)) * 0.74;

        vec2 cave_up = vec2(cos(angle), sin(angle));
        vec2 tangent = vec2(cave_up.y, -cave_up.x);
        float cave_depth = mix(min_cave_depth, max_cave_depth, hash(vec2(slot_id + 5.1, 13.7)));
        float cave_radius = uPlanetRadius * (1.0 - cave_depth);
        vec2 cave_center = uWorldCenter + cave_up * cave_radius;

        float size_roll = hash(vec2(slot_id + 17.1, 2.6));
        float height_roll = hash(vec2(slot_id + 23.4, 9.2));
        float base_radius_tangent = mix(min_cave_radius_tangent, max_cave_radius_tangent, size_roll);
        float base_radius_up = mix(min_cave_radius_up, max_cave_radius_up, height_roll) * 0.75;
        int lobe_count = 2 + int(floor(hash(vec2(slot_id + 31.4, 4.8)) * 4.0));
        float lobe_spacing = mix(5.6, 10.8, hash(vec2(slot_id + 27.2, 12.3)));
        float lobe_span = lobe_spacing * 0.5 * float(max(lobe_count - 1, 0));
        bool side_pocket = hash(vec2(slot_id + 41.0, 6.9)) > 0.42;

        float local_field = 9999.0;
        vec2 previous_lobe = vec2(0.0);
        bool have_previous = false;

        for (int lobe = 0; lobe < 5; ++lobe)
        {
            if (lobe >= lobe_count) break;

            float lobe_t = lobe_count == 1 ? 0.0 : float(lobe) / float(lobe_count - 1);
            float along_jitter = (hash(vec2(slot_id * 13.0 + float(lobe), 51.0)) - 0.5) * base_radius_tangent * 0.55;
            float radial_jitter = (hash(vec2(slot_id * 9.0 + float(lobe), 61.0)) - 0.5) * base_radius_up * 0.75;
            float along_offset = mix(-lobe_span, lobe_span, lobe_t) + along_jitter;
            vec2 lobe_center = cave_center + tangent * along_offset + cave_up * radial_jitter;

            float radius_tangent = base_radius_tangent * mix(0.82, 1.18, hash(vec2(slot_id * 7.0 + float(lobe), 71.0)));
            float radius_up = base_radius_up * mix(0.86, 1.14, hash(vec2(slot_id * 5.0 + float(lobe), 81.0)));

            vec2 lobe_delta = world - lobe_center;
            float tangent_distance = dot(lobe_delta, tangent);
            float radial_distance_value = dot(lobe_delta, cave_up);
            float ellipse_field =
                (tangent_distance * tangent_distance) / max(radius_tangent * radius_tangent, 1e-4) +
                (radial_distance_value * radial_distance_value) / max(radius_up * radius_up, 1e-4) - 1.0;
            local_field = min(local_field, ellipse_field);

            if (have_previous)
            {
                vec2 segment = lobe_center - previous_lobe;
                float segment_length_sq = dot(segment, segment);
                float segment_t = segment_length_sq > 1e-5 ? clamp(dot(world - previous_lobe, segment) / segment_length_sq, 0.0, 1.0) : 0.0;
                vec2 closest = previous_lobe + segment * segment_t;
                vec2 corridor_delta = world - closest;
                float corridor_radius = max(min(radius_tangent, radius_up) * 0.78, 2.6);
                float corridor_field = dot(corridor_delta, corridor_delta) / max(corridor_radius * corridor_radius, 1e-4) - 1.0;
                local_field = min(local_field, corridor_field);
            }

            previous_lobe = lobe_center;
            have_previous = true;
        }

        if (side_pocket)
        {
            vec2 side_center;
            vec2 side_delta;
            float side_sign = hash(vec2(slot_id + 91.0, 3.3)) > 0.5 ? 1.0 : -1.0;
            side_center = cave_center + tangent * (base_radius_tangent * 0.55 * side_sign) - cave_up * (base_radius_up * 0.18);
            side_delta = world - side_center;

            float side_tangent_distance = dot(side_delta, tangent);
            float side_radial_distance = dot(side_delta, cave_up);
            float side_field =
                (side_tangent_distance * side_tangent_distance) / max((base_radius_tangent * 0.82) * (base_radius_tangent * 0.82), 1e-4) +
                (side_radial_distance * side_radial_distance) / max((base_radius_up * 0.72) * (base_radius_up * 0.72), 1e-4) - 1.0;
            local_field = min(local_field, side_field);
        }

        // The ceiling gets most of the breakup so the cave floor stays easier to read and walk on.
        float ceiling_factor = smooth_profile(clamp((dot(world - cave_center, cave_up) + base_radius_up * 0.24) / max(base_radius_up * 1.28, 1e-4), 0.0, 1.0));
        float ceiling_noise = fbm(world * 0.17 + vec2(slot_id * 0.93, -slot_id * 1.21));
        float ceiling_broken = fbm(world * 0.31 + vec2(slot_id * 1.67, slot_id * 0.41));
        float ceiling_ridges = 1.0 - abs(fbm(world * 0.47 + vec2(slot_id * -0.61, slot_id * 1.39)) * 2.0 - 1.0);
        float ceiling_scars = fbm(world * 0.63 + vec2(slot_id * 2.11, -slot_id * 0.77));
        local_field += (ceiling_noise - 0.42) * 0.42 * ceiling_factor;
        local_field += (ceiling_broken - 0.5) * 0.36 * ceiling_factor;
        local_field += (ceiling_ridges - 0.46) * 0.46 * ceiling_factor;
        local_field += (ceiling_scars - 0.5) * 0.24 * ceiling_factor;

        float floor_factor = smooth_profile(clamp((-dot(world - cave_center, cave_up) + base_radius_up * 0.55) / max(base_radius_up * 0.85, 1e-4), 0.0, 1.0));
        float floor_noise = fbm(world * 0.23 + vec2(slot_id * -0.49, slot_id * 1.13));
        local_field -= 0.16 * floor_factor;
        local_field += (floor_noise - 0.5) * 0.18 * floor_factor;

        float cave_profile = smooth_profile(clamp((0.18 - local_field) / 0.32, 0.0, 1.0));
        if (cave_profile <= 1e-4) continue;

        float cave_target = mix(4.0, -1.75, cave_profile);
        density = min(density, cave_target);
    }

    if (water <= 0.0)
    {
        water = -abs(density);
        if (water > -0.02) water = -0.02;
    }

    imageStore(ioField, pixel, vec4(density, water, 0.0, 0.0));
}
