#version 460 core

// pond pass
// ponds are generated from the cave slot layout instead of pure random positions so they feel like part of the cave floor
// the pass first carves a basin, then writes water, then rebuilds a small support shell so caves do not leak through around the water
// chatgpt helped with shaping and debugging this pass because most of the work is tuning overlapping profiles

layout(local_size_x = 16, local_size_y = 16) in;

layout(rgba32f, binding = 0) uniform coherent image2D ioField;

uniform vec2 uWorldCenter;
uniform vec2 uFieldOrigin;
uniform vec2 uCellSize;
uniform uint uSeed;
uniform float uPlanetRadius;

const float shallow_pond_depth = 3.0;
const float deep_pond_depth = 5.5;

#include "terrain/noise.glsl"
#include "terrain/cave_slots.glsl"

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(ioField);
    if (pixel.x >= size.x || pixel.y >= size.y) return;

    vec4 field = imageLoad(ioField, pixel);
    float density = field.r;
    float water = field.g;

    vec2 world = uFieldOrigin + vec2(pixel) * uCellSize;

    for (int slot = 0; slot < cave_slot_count; ++slot)
    {
        float slot_id = float(slot);
        if (!cave_slot_active(slot_id)) continue;

        CaveSlotProfile slot_profile = cave_slot_profile(slot);
        vec2 cave_up = slot_profile.cave_up;
        vec2 tangent = slot_profile.tangent;
        vec2 cave_center = slot_profile.cave_center;
        float size_roll = slot_profile.size_roll;
        float base_radius_tangent = slot_profile.base_radius_tangent;
        float base_radius_up = slot_profile.base_radius_up;
        float lobe_span = slot_profile.lobe_span;

        // only one basin goes deeper so the pattern does not repeat too evenly
        int pond_count = size_roll > 0.85 ? 4 : (size_roll > 0.58 ? 3 : (size_roll > 0.28 ? 2 : 1));
        int deep_pond_index = pond_count > 1 ? int(floor(hash(vec2(slot_id + 161.0, 23.0)) * float(pond_count))) : 0;

        for (int pond = 0; pond < 4; ++pond)
        {
            if (pond >= pond_count) break;

            // ponds are laid along the cave tangent so they sit on the cave floor rather than floating in the radial field
            float pond_t = pond_count == 1 ? 0.5 : float(pond + 1) / float(pond_count + 1);
            float pond_along = mix(-lobe_span * 0.52, lobe_span * 0.52, pond_t);
            pond_along += (hash(vec2(slot_id * 17.0 + float(pond), 101.0)) - 0.5) * base_radius_tangent * 0.28;

            bool deep_pond = pond == deep_pond_index;
            float deep_multiplier = deep_pond ? 1.55 : 1.0;
            float wall_thickness = deep_pond ? 2.15 : 1.65;
            float floor_thickness = deep_pond ? 2.30 : 1.70;
            float support_depth = deep_pond ? 1.90 : 1.35;
            vec2 pond_floor_anchor = cave_center + tangent * pond_along - cave_up * (base_radius_up * (0.74 + (deep_pond ? 0.04 : 0.0)));
            float pond_half_length = mix(base_radius_tangent * 0.62, base_radius_tangent * 0.96, hash(vec2(slot_id * 19.0 + float(pond), 111.0))) * (deep_pond ? 1.10 : 1.0);
            float pond_depth = mix(shallow_pond_depth, deep_pond_depth, hash(vec2(slot_id * 23.0 + float(pond), 121.0))) * deep_multiplier;

            vec2 pond_delta = world - pond_floor_anchor;
            float pond_along_distance = dot(pond_delta, tangent);
            float pond_down = dot(pond_delta, -cave_up);
            if (pond_down < 0.0 || pond_down > pond_depth + floor_thickness + support_depth) continue;

            float lateral_signed = pond_half_length - abs(pond_along_distance);
            float lateral_profile = smooth_profile(clamp(lateral_signed / max(pond_half_length, 1e-4), 0.0, 1.0));
            float local_pond_depth = pond_depth * mix(0.58, 1.0, lateral_profile);
            if (pond_down > local_pond_depth + floor_thickness + support_depth) continue;

            float basin_signed = min(lateral_signed, min(pond_down, local_pond_depth - pond_down));
            float basin_profile = smooth_profile(clamp(basin_signed / max(local_pond_depth * 0.32, 0.28), 0.0, 1.0));
            if (basin_profile > 1e-4)
            {
                // first make empty room for the pond; the water field is written separately below
                float basin_cavity_target = deep_pond ? -6.6 : -4.8;
                density = min(density, mix(density, basin_cavity_target, basin_profile));
            }

            float water_surface_down = local_pond_depth * (deep_pond ? 0.12 : 0.20);
            float water_signed = min(lateral_signed, min(pond_down - water_surface_down, local_pond_depth - pond_down));
            float water_profile = smooth_profile(clamp(water_signed / max(local_pond_depth * 0.24, 0.24), 0.0, 1.0));

            // rebuild a small shell after carving so cave noise does not leave paper-thin walls around the water
            float outer_lateral_signed = lateral_signed + wall_thickness;
            float outer_vertical_signed = min(pond_down - water_surface_down, (local_pond_depth + floor_thickness) - pond_down);
            float shell_signed = min(outer_lateral_signed, min(outer_vertical_signed, -water_signed));
            if (shell_signed > 1e-4)
            {
                float shell_strength = deep_pond ? 5.6 : 5.0;
                density = max(density, shell_signed * shell_strength);
            }

            float support_lateral_signed = (pond_half_length + wall_thickness * 0.75) - abs(pond_along_distance);
            float support_vertical_signed = min(pond_down - (local_pond_depth - 0.10), (local_pond_depth + floor_thickness + support_depth) - pond_down);
            float support_signed = min(support_lateral_signed, support_vertical_signed);
            if (support_signed > 1e-4)
            {
                float support_strength = deep_pond ? 6.6 : 5.8;
                density = max(density, support_signed * support_strength);
            }

            if (water_profile <= 1e-4) continue;

            // water is its own signed field clipped by terrain in field_sampling.glsl, not just a color on the ground mesh
            float water_cavity_target = deep_pond ? -8.0 : -5.8;
            density = min(density, mix(density, water_cavity_target, water_profile));

            float water_strength = deep_pond ? 8.8 : 6.8;
            water = max(water, water_signed * water_strength);
        }
    }

    if (water <= 0.0)
    {
        // same convention as cave_gen: negative water outside ponds, positive water inside the pond volume
        water = -abs(density);
        if (water > -0.02) water = -0.02;
    }

    imageStore(ioField, pixel, vec4(density, water, 0.0, 0.0));
}
