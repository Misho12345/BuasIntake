#version 460 core

layout(local_size_x = 16, local_size_y = 16) in;

layout(rgba32f, binding = 0) uniform readonly image2D uField;

struct TerrainEdit
{
	vec4 positionRadiusStrength;
	vec4 shape;
};

layout(std430, binding = 1) readonly buffer TerrainEdits
{
	TerrainEdit data[];
} uTerrainEdits;

struct TerrainEditCandidate
{
	ivec2 pixel;
	float distanceToCenter;
	float padding;
};

layout(std430, binding = 3) buffer TerrainEditCandidates
{
	TerrainEditCandidate data[];
} uCandidates;

layout(std430, binding = 4) buffer TerrainEditCandidateCount
{
	uint count;
} uCandidateCount;

uniform uint  uMaxCandidateCount;
uniform ivec2 uDispatchOrigin;
uniform ivec2 uDispatchSize;
uniform ivec2 uChunkCoord;
uniform ivec2 uChunkGridSize;
uniform vec2  uChunkSize;
uniform vec2  uWorldCenter;
uniform vec2  uFieldOrigin;
uniform vec2  uCellSize;
uniform uint  uSeed;
uniform float uPlanetRadius;
uniform float uHardRockDepthThreshold;
uniform int   uHasBlocker;
uniform vec2  uBlockerCenter;
uniform vec2  uBlockerRight;
uniform vec2  uBlockerUp;
uniform vec2  uBlockerHalfExtents;

vec2 grid_to_world(vec2 g)
{
	return uFieldOrigin + g * uCellSize;
}

float hash(vec2 p)
{
	float seed = float(uSeed) * 0.0009765625;
	p = fract(p * vec2(0.1031, 0.11369) + seed);
	p += dot(p, p.yx + 19.19 + seed * 7.0);
	return fract((p.x + p.y) * (p.x + 13.37));
}

float noise(vec2 p)
{
	vec2 i = floor(p);
	vec2 f = fract(p);

	float a = hash(i);
	float b = hash(i + vec2(1.0, 0.0));
	float c = hash(i + vec2(0.0, 1.0));
	float d = hash(i + vec2(1.0, 1.0));

	vec2 u = f * f * (3.0 - 2.0 * f);
	return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
}

float fbm(vec2 p)
{
	float v = 0.0;
	float a = 0.5;

	for (int i = 0; i < 7; ++i)
	{
		v += a * noise(p);
		p = p * 2.03 + vec2(11.7, -8.3);
		a *= 0.5;
	}

	return v;
}

float ridged_fbm(vec2 p)
{
	float v = 0.0;
	float a = 0.55;

	for (int i = 0; i < 6; ++i)
	{
		float n = noise(p);
		n = 1.0 - abs(n * 2.0 - 1.0);
		v += n * a;
		p = p * 2.18 + vec2(-6.4, 9.1);
		a *= 0.55;
	}

	return v;
}

float surface_radius(vec2 direction)
{
	vec2 seed_offset = vec2(0.0137, 0.0211) * uSeed;
	float macro = fbm(direction * 1.85 + seed_offset + vec2(3.1, -7.4));
	float medium = fbm(direction * 6.20 - seed_offset.yx + vec2(-11.2, 4.6));
	float ridges = ridged_fbm(direction * 11.50 + seed_offset * 1.3 + vec2(8.4, -5.6));
	float micro = fbm(direction * 23.0 - seed_offset * 0.75 + vec2(-4.2, 12.8));

	return uPlanetRadius +
		(macro - 0.5) * uPlanetRadius * 0.19 +
		(medium - 0.5) * uPlanetRadius * 0.07 +
		(ridges - 0.45) * uPlanetRadius * 0.045 +
		(micro - 0.5) * uPlanetRadius * 0.02;
}

bool point_inside_blocker(vec2 point)
{
	if (uHasBlocker == 0) return false;

	vec2 delta = point - uBlockerCenter;
	float local_x = dot(delta, uBlockerRight);
	float local_y = dot(delta, uBlockerUp);
	vec2 padding = uCellSize * 0.35;
	return
		abs(local_x) <= uBlockerHalfExtents.x + padding.x &&
		abs(local_y) <= uBlockerHalfExtents.y + padding.y;
}

bool sample_has_water(vec4 field)
{
	return min(-field.r, field.g) > 1e-4;
}

bool dig_protected_by_water(ivec2 pixel, vec2 world, vec2 up)
{
	vec2 tangent = vec2(up.y, -up.x);
	float cell_extent = min(uCellSize.x, uCellSize.y);
	float tangential_limit = cell_extent * 2.35;
	float outward_limit = cell_extent * 2.35;
	float inward_allowance = cell_extent * 0.60;
	ivec2 size = imageSize(uField);

	for (int oy = -4; oy <= 4; ++oy)
	{
		for (int ox = -4; ox <= 4; ++ox)
		{
			ivec2 neighbor = pixel + ivec2(ox, oy);
			if (neighbor.x < 0 || neighbor.y < 0 || neighbor.x >= size.x || neighbor.y >= size.y) continue;

			vec2 delta = grid_to_world(vec2(neighbor)) - world;
			float tangent_offset = abs(dot(delta, tangent));
			float up_offset = dot(delta, up);
			if (tangent_offset > tangential_limit) continue;
			if (up_offset < -inward_allowance || up_offset > outward_limit) continue;
			if (sample_has_water(imageLoad(uField, neighbor))) return true;
		}
	}

	return false;
}

bool dig_protected(ivec2 pixel, vec2 world, vec2 up, vec4 field_value, float distance_from_center)
{
	if (sample_has_water(field_value)) return true;
	if (dig_protected_by_water(pixel, world, up)) return true;

	float normalized_depth = 1.0 - distance_from_center / max(uPlanetRadius, 1e-4);
	return normalized_depth >= uHardRockDepthThreshold;
}

void main()
{
	ivec2 dispatch_id = ivec2(gl_GlobalInvocationID.xy);
	if (dispatch_id.x >= uDispatchSize.x || dispatch_id.y >= uDispatchSize.y) return;

	ivec2 pixel = uDispatchOrigin + dispatch_id;
	ivec2 size = imageSize(uField);
	if (pixel.x >= size.x || pixel.y >= size.y) return;

	TerrainEdit edit = uTerrainEdits.data[0];
	vec2 world = grid_to_world(vec2(pixel));
	vec2 delta = world - edit.positionRadiusStrength.xy;
	float radius = max(edit.positionRadiusStrength.z, 1e-4);
	float distance_to_center = length(delta);
	if (distance_to_center >= radius) return;

	vec4 field_value = imageLoad(uField, pixel);
	vec2 radial_offset = world - uWorldCenter;
	float distance_from_center = length(radial_offset);
	vec2 direction = distance_from_center > 1e-5 ? radial_offset / distance_from_center : vec2(0.0, 1.0);
	if (edit.positionRadiusStrength.w < 0.0 && dig_protected(pixel, world, direction, field_value, distance_from_center)) return;
	if (edit.positionRadiusStrength.w > 0.0 && point_inside_blocker(world)) return;

	float target_radius = surface_radius(direction);
	float base_density = target_radius - distance_from_center;
	bool hard_dig = edit.positionRadiusStrength.w < 0.0 && edit.shape.y >= 0.5;
	float normalized = 1.0 - distance_to_center / radius;
	float falloff_exponent = max(edit.shape.x, 0.001);
	float falloff = hard_dig ? 1.0 : pow(normalized, falloff_exponent);
	float next_density = hard_dig ? min(field_value.r, edit.positionRadiusStrength.w) : field_value.r + edit.positionRadiusStrength.w * falloff;
	next_density = clamp(next_density, -1.0, max(1.0, base_density));
	if (abs(next_density - field_value.r) <= 1e-6) return;

	uint index = atomicAdd(uCandidateCount.count, 1u);
	if (index >= uMaxCandidateCount) return;
	uCandidates.data[index].pixel = pixel;
	uCandidates.data[index].distanceToCenter = distance_to_center;
	uCandidates.data[index].padding = 0.0;
}
